# ==========================================
# Apple Insurance CRM - Backend Environment
# ==========================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. CORS & Frontend
# Specify the exact URL of the frontend (e.g. https://insurance-crm-frontend.vercel.app)
# This is used to restrict API access strictly to your domain.
FRONTEND_URL=http://localhost:5173

# 3. Security Secrets
# Generate secure random strings (e.g., using `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# 4. Database Configuration (TiDB / MySQL)
DB_HOST=localhost
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=insurance_db
DB_PORT=3306
DB_POOL_LIMIT=20
DB_SSL=false

# Alternatively, if you use a full connection URI (e.g., TiDB Serverless):
# DB_URI=mysql://user:password@host:4000/insurance_db?ssl=true

# 5. Background Jobs (Optional)
# Secret to authenticate internal cron job calls
CRON_SECRET=your_cron_secret_here

# 6. Third-Party Integrations
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
GEMINI_API_KEY=
