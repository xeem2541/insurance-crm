# ==============================================================================
# Apple Insurance CRM — Docker Environment Variables
# ==============================================================================
# COPY this file to .env (in the same directory as docker-compose.yml)
# and fill in your actual values.
# NEVER commit the .env file to Git
# ==============================================================================

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change_me_to_strong_root_password
MYSQL_DATABASE=insurance_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_to_strong_app_password

# --- JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_to_64_char_random_hex
JWT_REFRESH_SECRET=change_me_to_another_64_char_random_hex

# --- LINE Messaging API ---
LINE_CHANNEL_SECRET=get_from_line_developers_console
LINE_CHANNEL_ACCESS_TOKEN=get_from_line_developers_console

# --- Google Gemini ---
GEMINI_API_KEY=get_from_google_ai_studio

# --- Cron Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=change_me_to_32_char_random_hex

# --- Email (for daily backup reports) ---
GMAIL_USER=your_gmail@gmail.com
GMAIL_PASS=your_gmail_app_password
ADMIN_EMAIL=admin@yourcompany.com
